import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class BusRouteManagementSystem {
    public static void main(String[] args) {
        // Build the Penang bus route graph based on the image
        Map<String, List<Astar.Route>> graph = new HashMap<>();
        
        // Initialize all stations
        String[] stations = {
            "Batu Ferringhi", "Tanjung Bungah", "Straits Quay", "Pulau Tikus",
            "Gurney Drive", "Komtar", "Weld Quay", "Sungai Pinang",
            "Jelutong", "USM Gelugor"
        };
        
        for (String station : stations) {
            graph.put(station, new ArrayList<>());
        }
        
        // Add routes
        //Batu Ferringhi <--> Tanjung Bungah (5.7 KM)
        graph.get("Batu Ferringhi").add(new Astar.Route("Tanjung Bungah", 5.7));
        graph.get("Tanjung Bungah").add(new Astar.Route("Batu Ferringhi", 5.7));
        
        //Batu Ferringhi <--> Pulau Tikus (13.0 KM)
        graph.get("Batu Ferringhi").add(new Astar.Route("Pulau Tikus", 13.0));
        graph.get("Pulau Tikus").add(new Astar.Route("Batu Ferringhi", 13.0));
        
        //Tanjung Bungah <--> Pulau Tikus (7.5 KM)
        graph.get("Tanjung Bungah").add(new Astar.Route("Pulau Tikus", 7.5));
        graph.get("Pulau Tikus").add(new Astar.Route("Tanjung Bungah", 7.5));
        
        //Tanjung Bungah <--> Straits Quay (4.3 KM)
        graph.get("Tanjung Bungah").add(new Astar.Route("Straits Quay", 4.3));
        graph.get("Straits Quay").add(new Astar.Route("Tanjung Bungah", 4.3));
        
        //Straits Quay <--> Pulau Tikus (5.9 KM)
        graph.get("Straits Quay").add(new Astar.Route("Pulau Tikus", 5.9));
        graph.get("Pulau Tikus").add(new Astar.Route("Straits Quay", 5.9));
        
        //Straits Quay <--> Gurney Drive (4.4 KM)
        graph.get("Straits Quay").add(new Astar.Route("Gurney Drive", 4.4));
        graph.get("Gurney Drive").add(new Astar.Route("Straits Quay", 4.4));
        
        //Straits Quay <--> Komtar (7.9 KM)
        graph.get("Straits Quay").add(new Astar.Route("Komtar", 7.9));
        graph.get("Komtar").add(new Astar.Route("Straits Quay", 7.9));
        
        //Pulau Tikus <--> Komtar (4.4 KM)
        graph.get("Pulau Tikus").add(new Astar.Route("Komtar", 4.4));
        graph.get("Komtar").add(new Astar.Route("Pulau Tikus", 4.4));
        
        //Gurney Drive <--> Komtar (3.5 KM)
        graph.get("Gurney Drive").add(new Astar.Route("Komtar", 3.5));
        graph.get("Komtar").add(new Astar.Route("Gurney Drive", 3.5));
        
        //Gurney Drive <--> Weld Quay (4.9 KM)
        graph.get("Gurney Drive").add(new Astar.Route("Weld Quay", 4.9));
        graph.get("Weld Quay").add(new Astar.Route("Gurney Drive", 4.9));
        
        //Komtar <--> Weld Quay (1.5 KM)
        graph.get("Komtar").add(new Astar.Route("Weld Quay", 1.5));
        graph.get("Weld Quay").add(new Astar.Route("Komtar", 1.5));
        
        //Komtar <--> USM Gelugor (9.0 KM)
        graph.get("Komtar").add(new Astar.Route("USM Gelugor", 9.0));
        graph.get("USM Gelugor").add(new Astar.Route("Komtar", 9.0));
        
        //Sungai Pinang <--> Jelutong (2.8 KM)
        graph.get("Sungai Pinang").add(new Astar.Route("Jelutong", 2.8));
        graph.get("Jelutong").add(new Astar.Route("Sungai Pinang", 2.8));
        
        //Jelutong <--> USM Gelugor (5.8 KM)
        graph.get("Jelutong").add(new Astar.Route("USM Gelugor", 5.8));
        graph.get("USM Gelugor").add(new Astar.Route("Jelutong", 5.8));
        
        //Komtar <--> Sungai Pinang (2.4 KM) 
        graph.get("Komtar").add(new Astar.Route("Sungai Pinang", 2.4));
        graph.get("Sungai Pinang").add(new Astar.Route("Komtar", 2.4));
        
        System.out.println("=".repeat(80));
        System.out.println("PENANG BUS ROUTE MANAGEMENT SYSTEM");
        System.out.println("=".repeat(80));
        System.out.println("\nAvailable Stations:");
        System.out.println("Batu Ferringhi, Tanjung Bungah, Straits Quay, Pulau Tikus,");
        System.out.println("Gurney Drive, Komtar, Weld Quay, Sungai Pinang,");
        System.out.println("Jelutong, USM Gelugor");
        
        System.out.println("\n" + "=".repeat(80));
        
        // Test Route 1: Batu Ferringhi to Komtar
        System.out.println("\n>>> TEST 1: Batu Ferringhi --> Komtar");
        Astar solver1 = new Astar(graph, "Batu Ferringhi", "Komtar");
        Map<String, Object> result1 = solver1.solve();
        solver1.printRoute(result1);
        
        System.out.println("\n" + "=".repeat(80));
        
    }  
}
